+/*!
+ * \brief Detach the expired head of one timer list
+ * \param head the list
+ * \param time time for expiration check
+ * \return the expired timers chained by next (prev and timeout cleared),
+ * 0 when none expired
+ */
+static inline struct ro_tl *detach_expired_unsafe(
+		struct ro_tl *head, unsigned int time)
+{
+	struct ro_tl *tl, *last = 0, *ret = head->next;
+
+	for(tl = head->next; tl != head && tl->timeout <= time; tl = tl->next) {
+		LM_DBG("getting tl=%p tl->prev=%p tl->next=%p with %d\n", tl, tl->prev,
+				tl->next, tl->timeout);
+		tl->prev = 0;
+		tl->timeout = 0;
+		last = tl;
+	}
+	if(!last)
+		return 0;
+	last->next = 0;
+	head->next = tl;
+	tl->prev = head;
+	return ret;
+}
