 	if(rpc->scan(ctx, "S", &impu) < 1) {
 		rpc->fault(ctx, 400, "required IMPU argument");
@@ -65,12 +66,27 @@ static void reg_rpc_dereg_impu(rpc_t *rpc, void *ctx)
 	while(impucontact) {
 		LM_DBG("Deleting contact with AOR [%.*s]\n",
 				impucontact->contact->aor.len, impucontact->contact->aor.s);
+		dereg_contact = impucontact->contact->c;
 		ul.lock_contact_slot_i(impucontact->contact->sl);
 		impucontact->contact->state = CONTACT_DELETE_PENDING;
 		if(impu_rec->shead) {
-			//send NOTIFY to all subscribers of this IMPU.
-			notify_subscribers(impu_rec, impucontact->contact, 0, 0,
-					IMS_REGISTRAR_CONTACT_UNREGISTERED);
+			/* Send NOTIFY to all subscribers of this IMPU, passing the contact
+			 * URI as an explicit de-registration contact.  The notification is
+			 * only queued here; the body is rendered later, in the
+			 * notification worker, by generate_reginfo_full().  By then this
+			 * contact is CONTACT_DELETED - set below, two statements away and
+			 * under the very contact slot lock the renderer needs - so
+			 * process_xml_for_contact() returns early for it and the NOTIFY
+			 * goes out with no <contact> child at all.  A watcher that only
+			 * removes a contact it can find in the body (ims_registrar_pcscf)
+			 * therefore keeps its binding, and its IPsec tunnel with it.
+			 * new_notification() copies the explicit contact URI into the
+			 * queued notification, and generate_reginfo_full() emits it from
+			 * that copy, so the body no longer depends on when the render
