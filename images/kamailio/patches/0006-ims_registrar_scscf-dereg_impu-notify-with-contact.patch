+			notify_subscribers(impu_rec, impucontact->contact, &dereg_contact,
+					1, IMS_REGISTRAR_CONTACT_UNREGISTERED);
 		}
 		impucontact->contact->state = CONTACT_DELETED;
 		ul.unlock_contact_slot_i(impucontact->contact->sl);
