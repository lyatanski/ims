+/**
+ * Data length of a fixed-size base protocol AVP (RFC 6733 4.5, 8.21).
+ * @returns the length, 0 if the AVP has no fixed size
+ */
+static int base_avp_fixed_len(AAA_AVP *avp)
+{
+	if(avp->vendorId != 0 || (avp->flags & AAA_AVP_FLAG_VENDOR_SPECIFIC))
+		return 0;
+	switch(avp->code) {
+		case 27:  /* Session-Timeout */
+		case 55:  /* Event-Timestamp */
+		case 85:  /* Acct-Interim-Interval */
+		case 258: /* Auth-Application-Id */
+		case 259: /* Acct-Application-Id */
+		case 261: /* Redirect-Host-Usage */
+		case 262: /* Redirect-Max-Cache-Time */
+		case 265: /* Supported-Vendor-Id */
+		case 266: /* Vendor-Id */
+		case 267: /* Firmware-Revision */
+		case 268: /* Result-Code */
+		case 270: /* Session-Binding */
+		case 271: /* Session-Server-Failover */
+		case 272: /* Multi-Round-Time-Out */
+		case 273: /* Disconnect-Cause */
+		case 274: /* Auth-Request-Type */
+		case 276: /* Auth-Grace-Period */
+		case 277: /* Auth-Session-State */
+		case 278: /* Origin-State-Id */
+		case 285: /* Re-Auth-Request-Type */
+		case 291: /* Authorization-Lifetime */
+		case 295: /* Termination-Cause */
+		case 298: /* Experimental-Result-Code */
+		case 299: /* Inband-Security-Id */
+		case 480: /* Accounting-Record-Type */
+		case 483: /* Accounting-Realtime-Required */
+		case 485: /* Accounting-Record-Number */
+			return 4;
+		case 287: /* Accounting-Sub-Session-Id */
+			return 8;
+	}
+	return 0;
+}
+
+/**
+ * Finds a fixed-size base protocol AVP whose length is wrong, also inside the
+ * base protocol groups that carry such AVPs.
+ * @param list - the AVPs to check
+ * @param top - set to the top-level AVP holding the offending one
+ * @returns the offending AVP, NULL if none
+ */
+static AAA_AVP *find_invalid_length_avp(AAA_AVP_LIST list, AAA_AVP **top)
+{
+	AAA_AVP *avp, *bad, *top2;
+	AAA_AVP_LIST group;
+	int len;
+
+	for(avp = list.head; avp; avp = avp->next) {
+		*top = avp;
+		len = base_avp_fixed_len(avp);
+		if(len && avp->data.len != len)
+			return avp;
+		if(avp->vendorId == 0
+				&& (avp->code == AVP_Vendor_Specific_Application_Id
+						|| avp->code == AVP_Experimental_Result)) {
+			group = AAAUngroupAVPS(avp->data);
+			bad = find_invalid_length_avp(group, &top2);
+			if(bad) {
+				/* the group's copy goes away below, the caller needs the
+				 * offending AVP itself */
+				bad = AAACloneAVP(bad, 1);
+				AAAFreeAVPList(&group);
+				return bad ? bad : avp;
+			}
+			AAAFreeAVPList(&group);
+		}
+	}
+	return 0;
+}
+
+/**
+ * Answers a request carrying an AVP of the wrong length with
+ * DIAMETER_INVALID_AVP_LENGTH (RFC 6733 7.1.5). Failed-AVP holds the
+ * offending AVP; one inside a group goes in a copy of the group holding only
+ * it (RFC 6733 7.5).
+ * @param p - the peer to answer
+ * @param req - the request
+ * @param top - the top-level AVP holding the offending one
+ * @param bad - the offending AVP
+ */
+static void Snd_invalid_avp_length(
+		peer *p, AAAMessage *req, AAA_AVP *top, AAA_AVP *bad)
+{
+	AAAMessage *ans;
+	AAA_AVP_LIST list = {0, 0};
+	AAA_AVP *avp;
+	str group;
+	char x[4];
+
+	ans = AAACreateResponse(req);
+	if(!ans)
+		return;
+	set_4bytes(x, DIAMETER_INVALID_AVP_LENGTH);
+	AAACreateAndAddAVPToMessage(
+			ans, AVP_Result_Code, AAA_AVP_FLAG_MANDATORY, 0, x, 4);
+
+	avp = AAACloneAVP(bad, 1);
+	if(avp && top != bad) {
+		AAAAddAVPToList(&list, avp);
+		group = AAAGroupAVPS(list);
+		AAAFreeAVPList(&list);
+		avp = group.len ? AAACreateAVP(top->code, top->flags, top->vendorId,
+								  group.s, group.len, AVP_FREE_DATA)
+						: 0;
+		if(!avp && group.s)
+			shm_free(group.s);
+	}
+	if(avp) {
+		AAAAddAVPToList(&list, avp);
+		group = AAAGroupAVPS(list);
+		AAAFreeAVPList(&list);
+		if(group.len) {
+			AAACreateAndAddAVPToMessage(ans, AVP_Failed_AVP,
+					AAA_AVP_FLAG_MANDATORY, 0, group.s, group.len);
+			shm_free(group.s);
+		}
+	}
+	peer_send_msg(p, ans);
+}
+
+/**
+ * Checks the lengths of the fixed-size base protocol AVPs of a received
+ * message. A request with a wrong one is answered with
+ * DIAMETER_INVALID_AVP_LENGTH when the peer is open, an answer is dropped.
+ * @param msg - the message received, freed if it fails the check
+ * @param sp - the serviced peer that it was received on
+ * @returns 1 if the message passed, 0 if it was consumed
+ */
+static int check_avp_lengths(AAAMessage *msg, serviced_peer_t *sp)
+{
+	AAA_AVP *top, *bad;
+
+	bad = find_invalid_length_avp(msg->avpList, &top);
+	if(!bad)
+		return 1;
+	LM_ERR("[%.*s] %s %d has AVP %d of invalid length %d\n",
+			sp->p ? sp->p->fqdn.len : 0, sp->p ? sp->p->fqdn.s : 0,
+			is_req(msg) ? "Request" : "Answer", msg->commandCode, bad->code,
+			bad->data.len);
+	if(is_req(msg) && sp->p
+			&& (sp->p->state == I_Open || sp->p->state == R_Open))
+		Snd_invalid_avp_length(sp->p, msg, top, bad);
+	if(bad != top)
+		AAAFreeAVP(&bad);
+	AAAFreeMessage(&msg);
+	return 0;
+}
