+static int rx_proto_has_prefix(str *proto, const char *prefix)
+{
+	int len = strlen(prefix);
+
+	return proto->len >= len && strncasecmp(proto->s, prefix, len) == 0;
+}
+
+/* RTP based transport: RTP/AVP, RTP/SAVPF, UDP/TLS/RTP/SAVP, ... */
+static int rx_proto_is_rtp(str *proto)
+{
+	int i;
+
+	for(i = 0; i + 4 <= proto->len; i++)
+		if(strncasecmp(proto->s + i, "RTP/", 4) == 0)
+			return 1;
+	return 0;
+}
