+/* 2026-01-01T00:00:00Z: the zero of the put-back sequence numbers */
+#define IPSEC_RESTORE_OSEQ_EPOCH 1767225600
+/* keep a put-back SA this far from where a 32-bit sequence number runs out */
+#define IPSEC_RESTORE_OSEQ_MAX 0xC0000000U
