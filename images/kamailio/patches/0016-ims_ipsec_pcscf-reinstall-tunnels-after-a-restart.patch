+	if(ipsec_restore_oseq_rate <= 0 || now <= IPSEC_RESTORE_OSEQ_EPOCH) {
+		return 0;
+	}
+	oseq = (uint64_t)(now - IPSEC_RESTORE_OSEQ_EPOCH)
+		   * (uint64_t)ipsec_restore_oseq_rate;
+	if(oseq > IPSEC_RESTORE_OSEQ_MAX) {
+		LM_WARN("outbound sequence numbers from %d/s since the epoch would "
+				"leave no headroom, starting at %u - lower "
+				"ipsec_restore_oseq_rate\n",
+				ipsec_restore_oseq_rate, IPSEC_RESTORE_OSEQ_MAX);
+		oseq = IPSEC_RESTORE_OSEQ_MAX;
