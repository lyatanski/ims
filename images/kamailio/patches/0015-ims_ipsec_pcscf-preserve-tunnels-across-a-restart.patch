+
+static void count_contact_tunnel(udomain_t *d, pcontact_t *c, void *param)
+{
+	if(contact_tunnel(c->security)) {
+		((restore_stats_t *)param)->tunnels++;
+	}
+	if(contact_tunnel(c->security_temp)) {
+		((restore_stats_t *)param)->tunnels++;
+	}
+}
+
+static void restore_tunnel(pcontact_t *c, ipsec_t *s, restore_stats_t *st)
+{
+	st->tunnels++;
+
+	if(reserve_spi(s->spi_pc, s->spi_ps, s->port_pc, s->port_ps) == 0) {
+		st->reserved++;
+	} else {
+		LM_WARN("contact [%.*s]: SPI pair %u/%u (ports %u/%u) is not free, "
+				"another tunnel may be handed the same pair\n",
+				c->aor.len, c->aor.s, s->spi_pc, s->spi_ps, s->port_pc,
+				s->port_ps);
+	}
+}
+
+static void restore_contact_tunnel(udomain_t *d, pcontact_t *c, void *param)
+{
+	restore_stats_t *st = (restore_stats_t *)param;
+	ipsec_t *est = contact_tunnel(c->security);
+	ipsec_t *pend = contact_tunnel(c->security_temp);
+
+	if(!est && !pend) {
+		return;
+	}
+	// Both: the UE may answer the offer over the new one, and still sends
+	// over the one it is registered over until then
+	if(est) {
+		restore_tunnel(c, est, st);
+	}
+	if(pend) {
+		restore_tunnel(c, pend, st);
+	}
+
+	// The same subscription ipsec_create() takes: without it the contact's
+	// expiry would leave its tunnel in the kernel and its SPI pair used.
+	if(ul.is_ulcb_registered(c, ipsec_on_expire)
+			|| ul.register_ulcb(c, PCSCF_CONTACT_EXPIRE | PCSCF_CONTACT_DELETE,
+					   ipsec_on_expire, (void *)&c->received_port)
+					   == 1) {
+		st->subscribed++;
+	} else {
+		LM_ERR("contact [%.*s]: failed to subscribe for its expiry\n",
+				c->aor.len, c->aor.s);
+	}
+}
+
+/**
+ * Take over the tunnels a previous instance left in the kernel.
+ *
+ * With ipsec_preserve_tunnels the SAs and policies are not flushed at startup
+ * or shutdown, so a kamailio restart inside the same network namespace - a
+ * container restart in a pod that keeps its sandbox - finds every tunnel still
+ * installed, sequence counters and all. What the new instance lacks is the
+ * bookkeeping: ims_usrloc_pcscf has preloaded each contact's tunnels - the
+ * registered one from its unprefixed security columns and the one on offer
+ * from its t_* columns - and here the SPI pair each one holds is marked used
+ * and the contact subscribed for its expiry, exactly as ipsec_create() would
+ * have.
+ *
+ * Tunnels no preloaded contact accounts for are removed first. That has to
+ * happen before any pair is reserved: delete_unused_tunnels() releases a pair
+ * for every SA it removes, and with nothing reserved yet those releases have
+ * nothing to put back.
+ *
+ * Runs in the PROC_SIPINIT child, after ims_usrloc_pcscf's preload, which is
+ * why this module has to be loaded after ims_usrloc_pcscf.
+ */
+int ipsec_restore_tunnels()
+{
+	restore_stats_t st;
+	int contacts;
+
+	memset(&st, 0, sizeof(st));
+	contacts = ul.walk_pcontacts(count_contact_tunnel, &st);
+
+	if(st.tunnels == 0) {
+		// delete_unused_tunnels() does nothing without a contact to compare
+		// against, and with none holding a tunnel everything installed is
+		// unaccounted for
+		LM_INFO("no preloaded contact holds a tunnel (%d contacts), removing "
+				"all IPSec SAs and policies\n",
+				contacts);
+		return ipsec_cleanall();
+	}
+
+	if(delete_unused_tunnels() != 0) {
+		LM_WARN("failed to remove the tunnels no contact accounts for\n");
+	}
+
+	memset(&st, 0, sizeof(st));
+	ul.walk_pcontacts(restore_contact_tunnel, &st);
+
+	LM_INFO("restored %d IPSec tunnels from %d preloaded contacts: %d SPI "
+			"pairs reserved, %d contacts subscribed for expiry\n",
+			st.tunnels, contacts, st.reserved, st.subscribed);
+
