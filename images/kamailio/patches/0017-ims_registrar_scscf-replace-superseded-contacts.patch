+{
+	int sos;
+	str instance, c_instance;
+	unsigned int reg_id, c_reg_id;
+
+	if(!impi || impi->len <= 0 || c->private_identity.len != impi->len
+			|| memcmp(c->private_identity.s, impi->s, impi->len) != 0)
+		return 0;
+	sos = cscf_get_sos_uri_param(chi->uri);
+	if(sos < 0)
