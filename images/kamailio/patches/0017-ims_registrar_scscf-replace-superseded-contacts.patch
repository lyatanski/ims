+	if(calc_contact_expires(chi, expires_hdr, sos) <= act_time)
+		return 0; /* this Contact is being removed, it replaces nothing */
+	if((cscf_get_sos_uri_param(c->c) > 0) != (sos > 0))
+		return 0;
+	if(!chi->reg_id)
+		return 1;
