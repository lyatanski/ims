diff --git a/src/modules/ims_qos/rx_avp.c b/src/modules/ims_qos/rx_avp.c
index 2d3cc5dc2b..3a638b1f86 100644
--- a/src/modules/ims_qos/rx_avp.c
+++ b/src/modules/ims_qos/rx_avp.c
@@ -671,6 +671,48 @@ inline int rx_add_media_component_description_avp(AAAMessage *msg, int number,
 }
 
 
+/* Media-Component-Description removing a media component: only the
+ * number and Flow-Status REMOVED (TS 29.213 Table 6.2.1) */
+int rx_add_media_component_removed_avp(AAAMessage *msg, int number)
+{
+	str data;
+	AAA_AVP_LIST list;
+	AAA_AVP *media_component_number, *flow_status;
+	char x[4];
+
+	list.head = 0;
+	list.tail = 0;
+
+	set_4bytes(x, number);
+	media_component_number = cdpb.AAACreateAVP(AVP_IMS_Media_Component_Number,
+			AAA_AVP_FLAG_MANDATORY | AAA_AVP_FLAG_VENDOR_SPECIFIC,
+			IMS_vendor_id_3GPP, x, 4, AVP_DUPLICATE_DATA);
+	if(!media_component_number) {
+		LM_ERR("Unable to create media_component_number AVP\n");
+		return 0;
+	}
+	cdpb.AAAAddAVPToList(&list, media_component_number);
+
+	set_4bytes(x, AVP_IMS_Flow_Status_Removed);
+	flow_status = cdpb.AAACreateAVP(AVP_IMS_Flow_Status,
+			AAA_AVP_FLAG_MANDATORY | AAA_AVP_FLAG_VENDOR_SPECIFIC,
+			IMS_vendor_id_3GPP, x, 4, AVP_DUPLICATE_DATA);
+	if(!flow_status) {
+		LM_ERR("Unable to create flow_status AVP\n");
+		cdpb.AAAFreeAVPList(&list);
+		return 0;
+	}
+	cdpb.AAAAddAVPToList(&list, flow_status);
+
+	data = cdpb.AAAGroupAVPS(list);
+	cdpb.AAAFreeAVPList(&list);
+
+	return rx_add_avp(msg, data.s, data.len,
+			AVP_IMS_Media_Component_Description,
+			AAA_AVP_FLAG_MANDATORY | AAA_AVP_FLAG_VENDOR_SPECIFIC,
+			IMS_vendor_id_3GPP, AVP_FREE_DATA, __FUNCTION__);
+}
+
