+/* whether the media component was authorised by an earlier AAR */
+static int rx_media_was_authorised(rx_authsessiondata_t *session_data, int num)
+{
+	flow_description_t *fd;
+
+	for(fd = session_data->first_current_flow_description; fd; fd = fd->next)
+		if(fd->stream_num == num)
+			return 1;
+	return 0;
+}
