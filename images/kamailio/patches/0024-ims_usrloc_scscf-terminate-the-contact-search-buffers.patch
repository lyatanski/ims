+ *  terminating NUL the callers' strstr() needs
  *  returns:
  *  0 => found
  *  1 => not found
@@ -56,19 +58,21 @@ static int filter_default_port(str *src, str *dst)
 	str default_port = str_init(":5060");
 	char *port;
 
+	if(dst->len < src->len) {
+		LM_BUG("dst len < src len\n");
+		return -1;
+	}
 	if((port = str_search(src, &default_port))) {
 		dst->len = port - src->s;
 		memcpy(dst->s, src->s, dst->len);
 		memcpy(dst->s + dst->len, port + 5, src->len - dst->len - 5);
 		dst->len = src->len - 5;
+		dst->s[dst->len] = '\0';
 		return 0;
 	}
-	if(dst->len < src->len) {
-		LM_BUG("dst len < src len\n");
-		return -1;
-	}
 	dst->len = src->len;
 	memcpy(dst->s, src->s, src->len);
+	dst->s[dst->len] = '\0';
 	return 1;
 }
 
