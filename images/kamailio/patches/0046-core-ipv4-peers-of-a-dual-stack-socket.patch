diff --git a/src/core/ip_addr.h b/src/core/ip_addr.h
index 511724c7a4..284362767f 100644
--- a/src/core/ip_addr.h
+++ b/src/core/ip_addr.h
@@ -106,6 +106,7 @@ typedef enum si_flags
 	SI_IS_ANY = (1 << 3),
 	SI_IS_MHOMED = (1 << 4),
 	SI_IS_VIRTUAL = (1 << 5),
+	SI_IS_DUALSTACK = (1 << 6), /* [::] without IPV6_V6ONLY: takes IPv4 too */
 } si_flags_t;
 
 typedef struct addr_info
@@ -556,6 +557,47 @@ static inline unsigned short su_getport(const union sockaddr_union *su)
 }
 
 
+/* an IPv4 peer of a dual-stack socket arrives as ::ffff:a.b.c.d: turns su
+ * into the plain IPv4 address it stands for, keeping the port
+ * returns 1 if su was changed, 0 if it was not a v4-mapped address */
+static inline int su_v4unmap(union sockaddr_union *su)
+{
+	struct in_addr a4;
+	unsigned short port;
+
+	if(su->s.sa_family != AF_INET6
+			|| !IN6_IS_ADDR_V4MAPPED(&su->sin6.sin6_addr))
+		return 0;
+	memcpy(&a4, &su->sin6.sin6_addr.s6_addr[12], 4);
+	port = su->sin6.sin6_port;
+	memset(su, 0, sizeof(*su));
+	su->sin.sin_family = AF_INET;
+	su->sin.sin_port = port;
+	su->sin.sin_addr = a4;
+#ifdef HAVE_SOCKADDR_SA_LEN
+	su->sin.sin_len = sizeof(struct sockaddr_in);
+#endif
+	return 1;
+}
+
+
+/* the reverse of su_v4unmap(): an IPv4 su as the ::ffff:a.b.c.d a dual-stack
+ * (AF_INET6) socket sends to */
+static inline void su_v4map(
+		union sockaddr_union *dst, const union sockaddr_union *src)
+{
+	memset(dst, 0, sizeof(*dst));
+	dst->sin6.sin6_family = AF_INET6;
+	dst->sin6.sin6_port = src->sin.sin_port;
+	dst->sin6.sin6_addr.s6_addr[10] = 0xff;
+	dst->sin6.sin6_addr.s6_addr[11] = 0xff;
+	memcpy(&dst->sin6.sin6_addr.s6_addr[12], &src->sin.sin_addr, 4);
+#ifdef HAVE_SOCKADDR_SA_LEN
+	dst->sin6.sin6_len = sizeof(struct sockaddr_in6);
+#endif
+}
+
+
 /* sets the port number (host byte order) */
 static inline void su_setport(union sockaddr_union *su, unsigned short port)
 {
diff --git a/src/core/socket_info.c b/src/core/socket_info.c
index 6eacc447f5..3edd7e8d10 100644
--- a/src/core/socket_info.c
+++ b/src/core/socket_info.c
@@ -2815,3 +2815,45 @@ struct socket_info *find_sock_info_by_address_family(
 
 	return si;
 }
+
+
+/* marks si SI_IS_DUALSTACK when it is an IPv6 socket bound to [::] that the
+ * kernel lets take IPv4 too (IPV6_V6ONLY off, net.ipv6.bindv6only 0); to be
+ * called once the socket is bound, before the processes are forked */
+void ksr_si_set_dualstack(struct socket_info *si)
+{
+#ifdef IPV6_V6ONLY
+	int v6only = 1;
+	socklen_t len = sizeof(v6only);
+
+	if(si->address.af != AF_INET6 || !(si->flags & SI_IS_ANY)
+			|| si->socket < 0)
+		return;
+	if(getsockopt(si->socket, IPPROTO_IPV6, IPV6_V6ONLY, &v6only, &len) != 0) {
+		LM_WARN("getsockopt IPV6_V6ONLY on %.*s: %s\n", si->sock_str.len,
+				si->sock_str.s, strerror(errno));
+		return;
+	}
+	if(v6only == 0) {
+		si->flags |= SI_IS_DUALSTACK;
+		LM_INFO("%.*s is dual-stack: IPv4 peers are handled as such\n",
+				si->sock_str.len, si->sock_str.s);
+	}
+#endif
+}
+
+/* the first dual-stack socket for proto (any port if port is 0), the one an
+ * IPv4 address of this host is reached on when no socket is bound to it */
+struct socket_info *find_si_dualstack(
+		unsigned short port, unsigned short proto)
+{
+	struct socket_info *si;
+	struct socket_info **list;
+
+	list = get_sock_info_list(proto);
+	for(si = list ? *list : NULL; si; si = si->next) {
+		if((si->flags & SI_IS_DUALSTACK) && (port == 0 || si->port_no == port))
+			return si;
+	}
+	return NULL;
+}
