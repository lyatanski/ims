+/**
+ * Counts the applications of our configuration with this id and type. The
+ * Vendor-Id an application is advertised with does not count (RFC 6733 5.3).
+ */
+static int count_config_applications(int id, int type)
+{
+	int i, cnt = 0;
+
+	for(i = 0; i < config->applications_cnt; i++)
+		if(id == config->applications[i].id
+				&& config->applications[i].type == type)
+			cnt++;
+	return cnt;
+}
