+#ifndef _X2_SEND_H_
+#define _X2_SEND_H_
+
+#include <stdint.h>
+#include <time.h>
+
+#include "../../core/atomic_ops.h"
+
+#include "x2_pdu.h"
+
+enum x2_state
+{
+	X2_DOWN = 0,
+	X2_CONNECTING,
+	X2_UP,
+};
+
+/* A Destination the sender delivers to, in shared memory so that RPC can
+ * read it. Only the sender process writes it */
+typedef struct x2_dest
+{
+	int used;
+	x2_addr_t addr;
+	int state;
+	time_t since;		   /* of the state */
+	unsigned long sent;	   /* PDUs */
+	unsigned long dropped; /* PDUs */
+	unsigned long connects;
+	unsigned int qlen;
+	unsigned int qbytes;
+
+	/* the sender's own */
+	int fd;
+	x2_link_t head;
+	x2_link_t tail;
+	unsigned int off; /* octets of the head sent */
+	time_t next_try;  /* of a connection */
+	time_t last_used; /* by an xIRI */
+	time_t ka_next;	  /* the next Keepalive */
+	time_t ka_out;	  /* the oldest Keepalive not acknowledged, or 0 */
+	time_t progress;  /* when the connection last took octets */
+	uint32_t ka_seq;
+	unsigned int failures;	 /* to connect, since the last connection */
+	unsigned char rbuf[128]; /* the start of the PDU being read */
+	unsigned int rhave;		 /* octets of it read */
+	unsigned int rtotal;	 /* its length, once rhave >= 12 */
+} x2_dest_t;
+
+typedef struct x2_shared
+{
+	atomic_t qbytes;  /* octets of all the PDUs not sent yet */
+	atomic_t dropped; /* PDUs no Destination got: queue full */
+	int ndest;
+	x2_dest_t dest[];
+} x2_shared_t;
+
+extern x2_shared_t *x2_sh;
+extern int x2_pipe[2];
+
+extern int x2_keepalive_interval;
+extern int x2_keepalive_timeout;
+extern int x2_connect_timeout;
+extern int x2_reconnect_interval;
+extern int x2_idle_timeout;
+extern int x2_dest_queue_size;
+extern int x2_seq_lifetime;
+
+void x2_sender_loop(void);
+void x2_job_free(x2_job_t *job);
+char *x2_dest_name(x2_dest_t *d);
+
+#endif
