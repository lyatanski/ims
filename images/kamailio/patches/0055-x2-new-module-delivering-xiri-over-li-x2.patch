+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA  02110-1301  USA
+ */
+
+#ifndef _X2_PDU_H_
+#define _X2_PDU_H_
+
+#include <stdint.h>
+#include <sys/time.h>
+
+#include "../../core/ip_addr.h"
+#include "../../core/str.h"
+
+/* ETSI TS 103 221-2 V1.10.1 5.2.1: major 0, minor 6 */
+#define X2_VERSION 6
+
+/* 5.2.2 PDU Type */
+#define X2_PDU_X2 1
+#define X2_PDU_X3 2
+#define X2_PDU_KEEPALIVE 3
+#define X2_PDU_KEEPALIVE_ACK 4
+
+/* 5.2.3: the mandatory fields alone */
+#define X2_HDR_LEN 40
+
+/* 5.4.1 Payload Format: a BER-encoded TS33128Payloads.XIRIPayload
+ * (TS 33.128 5.3.2) */
+#define X2_FMT_33128 2
+
+/* 5.2.6 Payload Direction */
+#define X2_DIR_UNKNOWN 1
+#define X2_DIR_TO_TARGET 2
+#define X2_DIR_FROM_TARGET 3
+#define X2_DIR_BOTH 4
+#define X2_DIR_NA 5
+
+/* 5.3.1 Conditional Attribute Types */
+#define X2_ATTR_NFID 6
+#define X2_ATTR_IPID 7
+#define X2_ATTR_SEQ 8
+#define X2_ATTR_TIMESTAMP 9
+#define X2_ATTR_SRC_IPV4 10
+#define X2_ATTR_DST_IPV4 11
+#define X2_ATTR_SRC_IPV6 12
+#define X2_ATTR_DST_IPV6 13
+#define X2_ATTR_SRC_PORT 14
+#define X2_ATTR_DST_PORT 15
+#define X2_ATTR_IP_PROTO 16
+#define X2_ATTR_MATCHED_TARGET 17
+
+/* The Sequence Number is the first conditional attribute of every PDU built
+ * here, so the sender can number a PDU without parsing it: this is the
+ * offset of its value */
+#define X2_SEQ_OFF (X2_HDR_LEN + 4)
+/* and of the XID and the Correlation ID, the context it numbers in */
+#define X2_XID_OFF 16
+#define X2_CORR_OFF 32
+
+/* TS 33.128 7.12.4.3.2 SessionDirection */
+#define X2_SESS_FROM_TARGET 1
+#define X2_SESS_TO_TARGET 2
+#define X2_SESS_COMBINED 3
+#define X2_SESS_INDETERMINATE 4
+
+/* Destinations one PDU goes to: the Destinations of one Task */
+#define X2_JOB_DST_MAX 8
+
+/* A Destination: an MDF2's address and port, over TCP or UDP */
+typedef struct x2_addr
+{
+	int proto; /* PROTO_TCP or PROTO_UDP */
+	union sockaddr_union su;
+} x2_addr_t;
+
+struct x2_job;
+/* A place in a Destination's queue: the job and which of its Destinations
+ * that queue belongs to */
+typedef struct x2_link
+{
+	struct x2_job *job;
+	int idx;
+} x2_link_t;
+
+/* One PDU on its way to its Destinations, in shared memory: a worker builds
+ * it, the sender process queues, sends and frees it */
+typedef struct x2_job
+{
+	unsigned int len; /* of pdu */
+	int seq;		  /* 1: the sender is to number it */
+	int ndst;		  /* entries of dst */
+	int refs;		  /* queues it is still in, sender only */
+	x2_addr_t dst[X2_JOB_DST_MAX];
+	x2_link_t next[X2_JOB_DST_MAX]; /* the next in each queue */
+	unsigned char pdu[];
+} x2_job_t;
+
+/* What an IMSMessage xIRI is built from */
+typedef struct x2_iri
+{
+	unsigned char xid[16];
+	uint64_t corr;
+	int pdir;		   /* Payload Direction */
+	int sdir;		   /* SessionDirection */
+	struct timeval ts; /* when the message was intercepted */
+	struct ip_addr src;
+	struct ip_addr dst;
+	unsigned short sport;
+	unsigned short dport;
+	int ipproto; /* IPPROTO_UDP, IPPROTO_TCP or IPPROTO_SCTP */
+	str sip;	 /* the SIP message */
+	str matched; /* Matched Target Identifier, may be empty */
+} x2_iri_t;
+
+x2_job_t *x2_ims_message_job(
+		x2_iri_t *iri, str *nfid, str *ipid, x2_addr_t *dst, int ndst);
+x2_job_t *x2_keepalive_job(int type, uint32_t seq, x2_addr_t *dst);
+
+#endif
