+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA  02110-1301  USA
+ */
+
+#include <string.h>
+#include <netinet/in.h>
+
+#include "../../core/dprint.h"
+#include "../../core/mem/shm_mem.h"
+
+#include "x2_pdu.h"
+
+/* xIRIPayloadOID of the ASN.1 the payload is encoded against: TS33128Payloads
+ * r19 version8, {threeGPP(4) ts33128(19) r19(19) version8(8) xIRI(1)}. An
+ * IMSMessage is the same from r17 on */
+static const unsigned char x2_xiri_oid[] = {4, 19, 19, 8, 1};
+
+/* XIRIEvent alternative iMSMessage [105], constructed: a high tag number */
+static const unsigned char tag_ims_message[] = {0xbf, 0x69};
+static const unsigned char tag_seq[] = {0x30};
+static const unsigned char tag_c1[] = {0xa1};
+static const unsigned char tag_c2[] = {0xa2};
+static const unsigned char tag_p1[] = {0x81};
+static const unsigned char tag_p2[] = {0x82};
+static const unsigned char tag_p3[] = {0x83};
+
+/* BER definite length: octets it takes */
+static unsigned int ber_len_size(unsigned int n)
+{
+	if(n < 0x80)
+		return 1;
+	if(n < 0x100)
+		return 2;
+	if(n < 0x10000)
+		return 3;
+	if(n < 0x1000000)
+		return 4;
+	return 5;
+}
+
+/* a whole TLV around n octets of contents, with a tag of tsize octets */
+static unsigned int ber_size(unsigned int tsize, unsigned int n)
+{
+	return tsize + ber_len_size(n) + n;
+}
+
+/* the tag and the length of a TLV; its contents go after */
+static unsigned char *ber_hdr(unsigned char *p, const unsigned char *tag,
+		unsigned int tsize, unsigned int n)
+{
+	unsigned int ls;
+
+	memcpy(p, tag, tsize);
+	p += tsize;
+	ls = ber_len_size(n);
+	if(ls == 1) {
+		*p++ = (unsigned char)n;
+		return p;
+	}
+	*p++ = 0x80 | (ls - 1);
+	for(ls = ls - 1; ls > 0; ls--)
+		*p++ = (n >> (8 * (ls - 1))) & 0xff;
+	return p;
+}
+
+/* IPAddress, a CHOICE and so explicitly tagged [n]: the tag of the field
+ * around [1] iPv4Address or [2] iPv6Address */
+static unsigned int ber_ipaddr_size(struct ip_addr *ip)
+{
+	return ber_size(1, ber_size(1, ip->len));
+}
+
+static unsigned char *ber_ipaddr(
+		unsigned char *p, const unsigned char *tag, struct ip_addr *ip)
+{
+	p = ber_hdr(p, tag, 1, ber_size(1, ip->len));
+	p = ber_hdr(p, ip->af == AF_INET ? tag_p1 : tag_p2, 1, ip->len);
+	memcpy(p, ip->u.addr, ip->len);
+	return p + ip->len;
+}
+
+static unsigned char *put16(unsigned char *p, unsigned int v)
+{
+	p[0] = (v >> 8) & 0xff;
+	p[1] = v & 0xff;
+	return p + 2;
+}
+
+static unsigned char *put32(unsigned char *p, uint32_t v)
+{
+	p[0] = (v >> 24) & 0xff;
+	p[1] = (v >> 16) & 0xff;
+	p[2] = (v >> 8) & 0xff;
+	p[3] = v & 0xff;
+	return p + 4;
+}
+
+static unsigned char *put64(unsigned char *p, uint64_t v)
+{
+	p = put32(p, (uint32_t)(v >> 32));
+	return put32(p, (uint32_t)v);
+}
+
+/* a conditional attribute (5.3.1) */
+static unsigned char *attr(
+		unsigned char *p, int type, const void *v, unsigned int len)
+{
+	p = put16(p, type);
+	p = put16(p, len);
+	memcpy(p, v, len);
+	return p + len;
+}
+
+static x2_job_t *job_new(unsigned int len, x2_addr_t *dst, int ndst)
+{
+	x2_job_t *job;
+
+	job = shm_malloc(sizeof(x2_job_t) + len);
+	if(job == NULL) {
+		SHM_MEM_ERROR;
+		return NULL;
+	}
+	memset(job, 0, sizeof(x2_job_t));
+	job->len = len;
+	job->ndst = ndst;
+	memcpy(job->dst, dst, ndst * sizeof(x2_addr_t));
+	return job;
+}
+
+/* The mandatory header fields (5.2) */
+static unsigned char *x2_hdr(unsigned char *p, int type, unsigned int hlen,
+		unsigned int plen, int fmt, int dir, const unsigned char *xid,
+		uint64_t corr)
+{
+	p = put16(p, X2_VERSION);
+	p = put16(p, type);
+	p = put32(p, hlen);
+	p = put32(p, plen);
+	p = put16(p, fmt);
+	p = put16(p, dir);
+	if(xid)
+		memcpy(p, xid, 16);
+	else
+		memset(p, 0, 16);
+	p += 16;
+	return put64(p, corr);
+}
+
+/* An X2 PDU carrying an IMSMessage xIRI (TS 33.128 7.12.4.2.1), with the
+ * conditional attributes of TS 33.128 5.3.1 and 5.3.2: the Sequence Number
+ * (left at zero for the sender to set), the Timestamp, the NFID and IPID
+ * when there are, the addresses and ports the SIP message went between,
+ * and the Matched Target Identifier when there is one */
+x2_job_t *x2_ims_message_job(
+		x2_iri_t *iri, str *nfid, str *ipid, x2_addr_t *dst, int ndst)
+{
+	unsigned int hlen, plen;
+	unsigned int sipmsg, payload, imsmsg, event, xiri;
+	unsigned char *p;
+	unsigned char v[4];
+	x2_job_t *job;
+
+	if(nfid->len > 0xffff || ipid->len > 0xffff || iri->matched.len > 0xffff) {
+		LM_ERR("conditional attribute longer than 65535 octets\n");
+		return NULL;
+	}
+
+	/* SIPMessage ::= SEQUENCE { iPSourceAddress [1] IPAddress,
+	 *   iPDestinationAddress [2] IPAddress, sIPContent [3] OCTET STRING } */
+	sipmsg = ber_ipaddr_size(&iri->src) + ber_ipaddr_size(&iri->dst)
+			 + ber_size(1, iri->sip.len);
+	/* IMSPayload ::= CHOICE { encapsulatedSIPMessage [1] SIPMessage }, in
+	 * IMSMessage.payload [1], explicit for a CHOICE */
+	payload = ber_size(1, sipmsg);
+	/* IMSMessage ::= SEQUENCE { payload [1] IMSPayload,
+	 *   sessionDirection [2] SessionDirection } */
+	imsmsg = ber_size(1, payload) + 3;
+	/* XIRIPayload.event [2] XIRIEvent, a CHOICE: iMSMessage [105] */
+	event = ber_size(2, imsmsg);
+	/* XIRIPayload ::= SEQUENCE { xIRIPayloadOID [1] RELATIVE-OID,
+	 *   event [2] XIRIEvent } */
+	xiri = ber_size(1, sizeof(x2_xiri_oid)) + ber_size(1, event);
+	plen = ber_size(1, xiri);
+
+	hlen = X2_HDR_LEN + 4 + 4					 /* Sequence Number */
+		   + 4 + 8								 /* Timestamp */
+		   + 4 + iri->src.len + 4 + iri->dst.len /* addresses */
+		   + 4 + 2 + 4 + 2						 /* ports */
+		   + 4 + 1;								 /* IP Protocol */
+	if(nfid->len > 0)
+		hlen += 4 + nfid->len;
+	if(ipid->len > 0)
+		hlen += 4 + ipid->len;
+	if(iri->matched.len > 0)
+		hlen += 4 + iri->matched.len;
+
+	job = job_new(hlen + plen, dst, ndst);
+	if(job == NULL)
+		return NULL;
+	job->seq = 1;
+
+	p = x2_hdr(job->pdu, X2_PDU_X2, hlen, plen, X2_FMT_33128, iri->pdir,
+			iri->xid, iri->corr);
+	/* first, at X2_SEQ_OFF */
+	memset(v, 0, 4);
+	p = attr(p, X2_ATTR_SEQ, v, 4);
+	p = put16(p, X2_ATTR_TIMESTAMP);
+	p = put16(p, 8);
+	p = put32(p, (uint32_t)iri->ts.tv_sec);
+	p = put32(p, (uint32_t)iri->ts.tv_usec * 1000);
+	if(nfid->len > 0)
+		p = attr(p, X2_ATTR_NFID, nfid->s, nfid->len);
+	if(ipid->len > 0)
+		p = attr(p, X2_ATTR_IPID, ipid->s, ipid->len);
+	p = attr(p, iri->src.af == AF_INET ? X2_ATTR_SRC_IPV4 : X2_ATTR_SRC_IPV6,
+			iri->src.u.addr, iri->src.len);
+	p = attr(p, iri->dst.af == AF_INET ? X2_ATTR_DST_IPV4 : X2_ATTR_DST_IPV6,
+			iri->dst.u.addr, iri->dst.len);
+	p = put16(p, X2_ATTR_SRC_PORT);
+	p = put16(p, 2);
+	p = put16(p, iri->sport);
+	p = put16(p, X2_ATTR_DST_PORT);
+	p = put16(p, 2);
+	p = put16(p, iri->dport);
+	p = put16(p, X2_ATTR_IP_PROTO);
+	p = put16(p, 1);
+	*p++ = (unsigned char)iri->ipproto;
+	if(iri->matched.len > 0)
+		p = attr(p, X2_ATTR_MATCHED_TARGET, iri->matched.s, iri->matched.len);
+
+	p = ber_hdr(p, tag_seq, 1, xiri);
+	p = ber_hdr(p, tag_p1, 1, sizeof(x2_xiri_oid));
+	memcpy(p, x2_xiri_oid, sizeof(x2_xiri_oid));
+	p += sizeof(x2_xiri_oid);
+	p = ber_hdr(p, tag_c2, 1, event);
+	p = ber_hdr(p, tag_ims_message, 2, imsmsg);
+	p = ber_hdr(p, tag_c1, 1, payload);
+	p = ber_hdr(p, tag_c1, 1, sipmsg);
+	p = ber_ipaddr(p, tag_c1, &iri->src);
+	p = ber_ipaddr(p, tag_c2, &iri->dst);
+	p = ber_hdr(p, tag_p3, 1, iri->sip.len);
+	memcpy(p, iri->sip.s, iri->sip.len);
+	p += iri->sip.len;
+	p = ber_hdr(p, tag_p2, 1, 1);
+	*p++ = (unsigned char)iri->sdir;
+
+	if(p != job->pdu + job->len) {
+		LM_BUG("PDU is %d octets, not %u\n", (int)(p - job->pdu), job->len);
+		shm_free(job);
+		return NULL;
+	}
+	return job;
+}
+
+/* A Keepalive or Keepalive Acknowledgement (5.1, 6.2.4): the mandatory
+ * fields, zero but for the Version, the PDU Type and the Header Length, and
+ * the Sequence Number */
+x2_job_t *x2_keepalive_job(int type, uint32_t seq, x2_addr_t *dst)
+{
+	unsigned char *p;
+	unsigned char v[4];
+	x2_job_t *job;
+
+	job = job_new(X2_HDR_LEN + 8, dst, 1);
+	if(job == NULL)
+		return NULL;
+	p = x2_hdr(job->pdu, type, X2_HDR_LEN + 8, 0, 0, 0, NULL, 0);
+	put32(v, seq);
+	attr(p, X2_ATTR_SEQ, v, 4);
+	return job;
+}
diff --git a/src/modules/x2/x2_pdu.h b/src/modules/x2/x2_pdu.h
