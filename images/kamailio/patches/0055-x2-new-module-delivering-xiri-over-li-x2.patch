+
+/*
+ * The X2 sender process. Workers hand it PDUs through a pipe; it numbers
+ * them, keeps a connection to each Destination (MDF2) with the Keepalives
+ * of ETSI TS 103 221-2 6.2.4, and queues what a Destination cannot take
+ * yet, up to dest_queue_size octets.
+ */
+
+#include <errno.h>
+#include <poll.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/socket.h>
+#include <netinet/in.h>
+#include <netinet/tcp.h>
+
+#include "../../core/dprint.h"
+#include "../../core/ip_addr.h"
+#include "../../core/mem/mem.h"
+#include "../../core/mem/shm_mem.h"
+#include "../../core/cfg/cfg_struct.h"
+
+#include "x2_send.h"
+
+/* The Sequence Number contexts (5.3.9): one per XID and Correlation ID, the
+ * NFID and IPID being the same for every PDU from here. Dropped once unused
+ * for seq_lifetime seconds, after which the context starts at 0 again */
+#define X2_SEQ_HASH 1024
+typedef struct x2_seqctx
+{
+	struct x2_seqctx *next;
+	unsigned char key[24];
+	uint32_t seq;
+	time_t used;
+} x2_seqctx_t;
+
+static x2_seqctx_t *x2_seqtab[X2_SEQ_HASH];
+static struct pollfd *x2_pfd;
+static x2_dest_t **x2_pdest;
+
+void x2_job_free(x2_job_t *job)
+{
+	atomic_add_int(&x2_sh->qbytes.val, -(int)job->len);
+	shm_free(job);
+}
+
+static void job_unref(x2_job_t *job)
+{
+	if(--job->refs == 0)
+		x2_job_free(job);
+}
+
+static void put32(unsigned char *p, uint32_t v)
+{
+	p[0] = (v >> 24) & 0xff;
+	p[1] = (v >> 16) & 0xff;
+	p[2] = (v >> 8) & 0xff;
+	p[3] = v & 0xff;
+}
+
+static uint32_t get32(const unsigned char *p)
+{
+	return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16)
+		   | ((uint32_t)p[2] << 8) | p[3];
+}
+
+char *x2_dest_name(x2_dest_t *d)
+{
+	static char name[IP_ADDR_MAX_STR_SIZE + 16];
+
+	snprintf(name, sizeof(name), "%s:%s",
+			d->addr.proto == PROTO_UDP ? "udp" : "tcp",
+			su2a(&d->addr.su, sizeof(d->addr.su)));
+	return name;
+}
+
+/* The first failure to connect is an error; the ones after it, until a
+ * connection is up again, are not news */
+#define X2_CONN_ERR(d, fmt, ...)        \
+	do {                                \
+		if((d)->failures++ == 0)        \
+			LM_ERR(fmt, ##__VA_ARGS__); \
+		else                            \
+			LM_DBG(fmt, ##__VA_ARGS__); \
+	} while(0)
+
+/* The next Sequence Number of the job's context */
+static void seq_assign(x2_job_t *job, time_t now)
+{
+	unsigned int h = 2166136261u;
+	unsigned char key[24];
+	x2_seqctx_t *c;
+	int i;
+
+	memcpy(key, job->pdu + X2_XID_OFF, 24);
+	for(i = 0; i < 24; i++)
+		h = (h ^ key[i]) * 16777619u;
+	h %= X2_SEQ_HASH;
+	for(c = x2_seqtab[h]; c; c = c->next)
+		if(memcmp(c->key, key, 24) == 0)
+			break;
+	if(c == NULL) {
+		c = pkg_malloc(sizeof(*c));
+		if(c == NULL) {
+			PKG_MEM_ERROR;
+			return; /* numbered 0 */
+		}
+		memcpy(c->key, key, 24);
+		c->seq = 0;
+		c->next = x2_seqtab[h];
+		x2_seqtab[h] = c;
+	}
+	c->used = now;
+	put32(job->pdu + X2_SEQ_OFF, c->seq++);
+}
+
+static void seq_sweep(time_t now)
+{
+	x2_seqctx_t **pc, *c;
+	int i;
+
+	for(i = 0; i < X2_SEQ_HASH; i++) {
+		pc = &x2_seqtab[i];
+		while((c = *pc) != NULL) {
+			if(now - c->used >= x2_seq_lifetime) {
+				*pc = c->next;
+				pkg_free(c);
+			} else {
+				pc = &c->next;
+			}
+		}
+	}
+}
+
+static void dq_push(x2_dest_t *d, x2_job_t *job, int idx)
+{
+	job->next[idx].job = NULL;
+	if(d->tail.job)
+		d->tail.job->next[d->tail.idx] = (x2_link_t){job, idx};
+	else
+		d->head = (x2_link_t){job, idx};
+	d->tail = (x2_link_t){job, idx};
+	job->refs++;
+	d->qlen++;
+	d->qbytes += job->len;
+}
+
+static void dq_pop(x2_dest_t *d)
+{
+	x2_job_t *job = d->head.job;
+
+	d->head = job->next[d->head.idx];
+	if(d->head.job == NULL)
+		d->tail.job = NULL;
+	d->qlen--;
+	d->qbytes -= job->len;
+	d->off = 0;
+	job_unref(job);
+}
+
+/* Drops the Keepalives and acknowledgements left in the queue: they were
+ * for the connection that is gone */
+static void dq_drop_keepalives(x2_dest_t *d)
+{
+	x2_link_t l = d->head, prev = {NULL, 0}, next;
+
+	while(l.job) {
+		next = l.job->next[l.idx];
+		if(l.job->pdu[3] != X2_PDU_X2) {
+			if(prev.job)
+				prev.job->next[prev.idx] = next;
+			else
+				d->head = next;
+			if(d->tail.job == l.job)
+				d->tail = prev;
+			d->qlen--;
+			d->qbytes -= l.job->len;
+			job_unref(l.job);
+		} else {
+			prev = l;
+		}
+		l = next;
+	}
+}
+
+static void dest_close(x2_dest_t *d, time_t now)
+{
+	if(d->fd >= 0)
+		close(d->fd);
+	d->fd = -1;
+	d->state = X2_DOWN;
+	d->since = now;
+	d->next_try = now + x2_reconnect_interval;
+	/* A PDU that went out in part is lost with the connection: send it
+	 * whole on the next one */
+	d->off = 0;
+	d->rhave = 0;
+	d->ka_out = 0;
+	dq_drop_keepalives(d);
+}
+
+static void dest_up(x2_dest_t *d, time_t now)
+{
+	d->state = X2_UP;
+	d->since = now;
+	d->connects++;
+	d->ka_next = now + x2_keepalive_interval;
+	d->ka_out = 0;
+	d->progress = now;
+	if(d->failures > 1)
+		LM_INFO("X2 Destination %s connected, after %u attempts\n",
+				x2_dest_name(d), d->failures + 1);
+	else
+		LM_INFO("X2 Destination %s connected\n", x2_dest_name(d));
+	d->failures = 0;
+}
+
+static void dest_connect(x2_dest_t *d, time_t now)
+{
+	int type = d->addr.proto == PROTO_UDP ? SOCK_DGRAM : SOCK_STREAM;
+	int on = 1;
+
+	d->fd = socket(
+			d->addr.su.s.sa_family, type | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
+	if(d->fd < 0) {
+		X2_CONN_ERR(d, "X2 Destination %s: socket: %s\n", x2_dest_name(d),
+				strerror(errno));
+		dest_close(d, now);
+		return;
+	}
+	if(type == SOCK_STREAM)
+		setsockopt(d->fd, IPPROTO_TCP, TCP_NODELAY, &on, sizeof(on));
+	if(connect(d->fd, &d->addr.su.s, sockaddru_len(d->addr.su)) == 0) {
+		dest_up(d, now);
+		return;
+	}
+	if(errno == EINPROGRESS) {
+		d->state = X2_CONNECTING;
+		d->since = now;
+		return;
+	}
+	X2_CONN_ERR(d, "X2 Destination %s: connect: %s\n", x2_dest_name(d),
+			strerror(errno));
+	dest_close(d, now);
+}
+
+static x2_dest_t *dest_get(x2_addr_t *a, time_t now)
+{
+	x2_dest_t *d, *free = NULL;
+	int i;
+
+	for(i = 0; i < x2_sh->ndest; i++) {
+		d = &x2_sh->dest[i];
+		if(!d->used) {
+			if(free == NULL)
+				free = d;
+			continue;
+		}
+		if(d->addr.proto == a->proto && su_cmp(&d->addr.su, &a->su))
+			return d;
+	}
+	if(free == NULL)
+		return NULL;
+	d = free;
+	memset(d, 0, sizeof(*d));
+	d->addr = *a;
+	d->fd = -1;
+	d->since = now;
+	d->used = 1;
+	return d;
+}
+
+/* A job from a worker: numbered, then queued to each of its Destinations */
+static void job_take(x2_job_t *job, time_t now)
+{
+	x2_dest_t *d;
+	int i;
+
+	if(job->seq)
+		seq_assign(job, now);
+	job->refs = 1; /* held until it is queued everywhere */
+	for(i = 0; i < job->ndst; i++) {
+		d = dest_get(&job->dst[i], now);
+		if(d == NULL) {
+			LM_ERR("X2: more Destinations than max_destinations, PDU for "
+				   "%s:%s dropped\n",
+					job->dst[i].proto == PROTO_UDP ? "udp" : "tcp",
+					su2a(&job->dst[i].su, sizeof(job->dst[i].su)));
+			atomic_add_int(&x2_sh->dropped.val, 1);
+			continue;
+		}
+		d->last_used = now;
+		if(d->qbytes + job->len > (unsigned int)x2_dest_queue_size) {
+			if(d->dropped++ % 1000 == 0)
+				LM_ERR("X2 Destination %s: queue full, PDU dropped (%lu so "
+					   "far)\n",
+						x2_dest_name(d), d->dropped);
+			continue;
+		}
+		dq_push(d, job, i);
+		if(d->state == X2_DOWN && d->fd < 0 && now >= d->next_try)
+			dest_connect(d, now);
+	}
+	job_unref(job);
+}
+
+static void ka_send(x2_dest_t *d, int type, uint32_t seq)
+{
+	x2_job_t *job;
+
+	job = x2_keepalive_job(type, seq, &d->addr);
+	if(job == NULL)
+		return;
+	atomic_add_int(&x2_sh->qbytes.val, job->len);
+	dq_push(d, job, 0);
+}
+
+/* A whole PDU from the MDF, of which rbuf holds the start */
+static void pdu_in(x2_dest_t *d)
+{
+	unsigned int type, hlen, i, alen;
+	uint32_t seq = 0;
+
+	type = (d->rbuf[2] << 8) | d->rbuf[3];
+	hlen = get32(d->rbuf + 4);
+	if(hlen > sizeof(d->rbuf))
+		hlen = sizeof(d->rbuf);
+	for(i = X2_HDR_LEN; i + 4 <= hlen; i += 4 + alen) {
+		alen = (d->rbuf[i + 2] << 8) | d->rbuf[i + 3];
+		if(((d->rbuf[i] << 8) | d->rbuf[i + 1]) == X2_ATTR_SEQ && alen == 4
+				&& i + 8 <= hlen) {
+			seq = get32(d->rbuf + i + 4);
+			break;
+		}
+	}
+	switch(type) {
+		case X2_PDU_KEEPALIVE:
+			ka_send(d, X2_PDU_KEEPALIVE_ACK, seq);
+			break;
+		case X2_PDU_KEEPALIVE_ACK:
+			d->ka_out = 0;
+			break;
+		default:
+			LM_DBG("X2 Destination %s sent PDU type %u, ignored\n",
+					x2_dest_name(d), type);
+	}
+}
+
+/* Reads what the MDF sent: only Keepalives and their acknowledgements are
+ * expected. Returns -1 when the connection is to be closed */
+static int dest_read(x2_dest_t *d)
+{
+	unsigned char buf[4096];
+	unsigned int take, plen, hlen;
+	ssize_t n;
+	unsigned char *p;
+
+	for(;;) {
+		n = recv(d->fd, buf, sizeof(buf), MSG_DONTWAIT);
+		if(d->addr.proto == PROTO_UDP) {
+			/* No Keepalives over UDP: what comes is a stray datagram, or
+			 * the error an ICMP message reported for an earlier one */
+			if(n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK))
+				return 0;
+			continue;
+		}
+		if(n == 0) {
+			LM_ERR("X2 Destination %s closed the connection\n",
+					x2_dest_name(d));
+			return -1;
+		}
+		if(n < 0) {
+			if(errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR)
+				return 0;
+			LM_ERR("X2 Destination %s: %s\n", x2_dest_name(d), strerror(errno));
+			return -1;
+		}
+		p = buf;
+		while(n > 0) {
+			if(d->rhave < 12) {
+				take = 12 - d->rhave;
+			} else {
+				take = d->rtotal - d->rhave;
+			}
+			if(take > n)
+				take = n;
+			if(d->rhave < sizeof(d->rbuf))
+				memcpy(d->rbuf + d->rhave, p,
+						take < sizeof(d->rbuf) - d->rhave
+								? take
+								: sizeof(d->rbuf) - d->rhave);
+			d->rhave += take;
+			p += take;
+			n -= take;
+			if(d->rhave == 12) {
+				hlen = get32(d->rbuf + 4);
+				plen = get32(d->rbuf + 8);
+				if(hlen < X2_HDR_LEN || hlen > 0xffff || plen > (1u << 24)) {
+					LM_ERR("X2 Destination %s sent a PDU with header length "
+						   "%u and payload length %u\n",
+							x2_dest_name(d), hlen, plen);
+					return -1;
+				}
+				d->rtotal = hlen + plen;
+			}
+			if(d->rhave >= 12 && d->rhave == d->rtotal) {
+				pdu_in(d);
+				d->rhave = 0;
+			}
+		}
+	}
+}
+
+/* Sends what is queued, as much as the socket takes. Returns -1 when the
+ * connection is to be closed */
+static int dest_write(x2_dest_t *d)
+{
+	x2_job_t *job;
+	ssize_t n;
+	int retry = 0;
+
+	while((job = d->head.job) != NULL) {
+		n = send(d->fd, job->pdu + d->off, job->len - d->off,
+				MSG_DONTWAIT | MSG_NOSIGNAL);
+		if(n < 0) {
+			if(errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR)
+				return 0;
+			if(d->addr.proto == PROTO_UDP) {
+				/* The error an ICMP message reported for an earlier
+				 * datagram fails the next send() instead, which then sends
+				 * nothing: once more */
+				if(errno == ECONNREFUSED && !retry) {
+					retry = 1;
+					continue;
+				}
+				/* one too long, or no route */
+				if(d->dropped++ % 1000 == 0)
+					LM_ERR("X2 Destination %s: %s, PDU dropped\n",
+							x2_dest_name(d), strerror(errno));
+				dq_pop(d);
+				continue;
+			}
+			LM_ERR("X2 Destination %s: %s\n", x2_dest_name(d), strerror(errno));
+			return -1;
+		}
+		retry = 0;
+		d->progress = time(NULL);
+		d->off += n;
+		if(d->off == job->len) {
+			if(job->pdu[3] == X2_PDU_KEEPALIVE && d->ka_out == 0)
+				d->ka_out = time(NULL);
+			if(job->pdu[3] == X2_PDU_X2)
+				d->sent++;
+			dq_pop(d);
+		}
+	}
+	return 0;
+}
+
+static void dest_event(x2_dest_t *d, short revents, time_t now)
+{
+	int err = 0;
+	socklen_t len = sizeof(err);
+
+	if(d->state == X2_CONNECTING) {
+		if(!(revents & (POLLOUT | POLLERR | POLLHUP)))
+			return;
+		if(getsockopt(d->fd, SOL_SOCKET, SO_ERROR, &err, &len) < 0)
+			err = errno;
+		if(err) {
+			X2_CONN_ERR(d, "X2 Destination %s: connect: %s\n", x2_dest_name(d),
+					strerror(err));
+			dest_close(d, now);
+			return;
+		}
+		dest_up(d, now);
+	}
+	if((revents & (POLLIN | POLLERR | POLLHUP)) && dest_read(d) < 0) {
+		dest_close(d, now);
+		return;
+	}
+	if(dest_write(d) < 0)
+		dest_close(d, now);
+}
+
+/* Once a second */
+static void dest_timers(x2_dest_t *d, time_t now)
+{
+	if(d->state == X2_CONNECTING && now - d->since >= x2_connect_timeout) {
+		X2_CONN_ERR(d, "X2 Destination %s: no connection in %d s\n",
+				x2_dest_name(d), x2_connect_timeout);
+		dest_close(d, now);
+	}
+	if(d->state == X2_UP && d->addr.proto != PROTO_UDP
+			&& x2_keepalive_interval > 0) {
+		if(d->ka_out && now - d->ka_out >= x2_keepalive_timeout) {
+			LM_ERR("X2 Destination %s: no Keepalive Acknowledgement in %d s\n",
+					x2_dest_name(d), x2_keepalive_timeout);
+			dest_close(d, now);
+		} else if(d->head.job && now - d->progress >= x2_keepalive_timeout) {
+			/* not reading: not even a Keepalive gets out to time out */
+			LM_ERR("X2 Destination %s: nothing sent in %d s\n", x2_dest_name(d),
+					x2_keepalive_timeout);
+			dest_close(d, now);
+		} else if(now >= d->ka_next) {
+			ka_send(d, X2_PDU_KEEPALIVE, d->ka_seq++);
+			d->ka_next = now + x2_keepalive_interval;
+			if(dest_write(d) < 0)
+				dest_close(d, now);
+		}
+	}
+	if(d->state == X2_DOWN && d->qlen > 0 && now >= d->next_try)
+		dest_connect(d, now);
+	if(x2_idle_timeout > 0 && d->qlen == 0
+			&& now - d->last_used >= x2_idle_timeout) {
+		if(d->fd >= 0)
+			LM_INFO("X2 Destination %s idle, closed\n", x2_dest_name(d));
+		dest_close(d, now);
+		d->used = 0;
+	}
+}
+
+static void pipe_read(time_t now)
+{
+	x2_job_t *jobs[512];
+	ssize_t n;
+	int i;
+
+	for(;;) {
+		n = read(x2_pipe[0], jobs, sizeof(jobs));
+		if(n <= 0)
+			return;
+		for(i = 0; i < n / (ssize_t)sizeof(x2_job_t *); i++)
+			job_take(jobs[i], now);
+	}
+}
+
+void x2_sender_loop(void)
+{
+	x2_dest_t *d;
+	time_t now, tick = 0, sweep;
+	int i, n;
+
+	x2_pfd = pkg_malloc((1 + x2_sh->ndest) * sizeof(struct pollfd));
+	x2_pdest = pkg_malloc((1 + x2_sh->ndest) * sizeof(x2_dest_t *));
+	if(x2_pfd == NULL || x2_pdest == NULL) {
+		PKG_MEM_ERROR;
+		return;
+	}
+	sweep = time(NULL);
+
+	for(;;) {
+		cfg_update();
+
+		x2_pfd[0].fd = x2_pipe[0];
+		x2_pfd[0].events = POLLIN;
+		n = 1;
+		for(i = 0; i < x2_sh->ndest; i++) {
+			d = &x2_sh->dest[i];
+			if(!d->used || d->fd < 0)
+				continue;
+			x2_pfd[n].fd = d->fd;
+			x2_pfd[n].events = POLLIN;
+			if(d->state == X2_CONNECTING || d->head.job)
+				x2_pfd[n].events |= POLLOUT;
+			x2_pfd[n].revents = 0;
+			x2_pdest[n] = d;
+			n++;
+		}
+		x2_pfd[0].revents = 0;
+		if(poll(x2_pfd, n, 1000) < 0 && errno != EINTR) {
+			LM_ERR("X2 sender: poll: %s\n", strerror(errno));
+			continue;
+		}
+		now = time(NULL);
+		for(i = 1; i < n; i++)
+			if(x2_pfd[i].revents)
+				dest_event(x2_pdest[i], x2_pfd[i].revents, now);
+		if(x2_pfd[0].revents & POLLIN)
+			pipe_read(now);
+		if(now != tick) {
+			tick = now;
+			for(i = 0; i < x2_sh->ndest; i++)
+				if(x2_sh->dest[i].used)
+					dest_timers(&x2_sh->dest[i], now);
+			if(now - sweep >= 60) {
+				seq_sweep(now);
+				sweep = now;
+			}
+		}
+	}
+}
