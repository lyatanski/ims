+/*
+ * x2: LI_X2 for an IRI-POI in a SIP node. x2_ims_message() reports the SIP
+ * message at hand as an IMSMessage xIRI (3GPP TS 33.128 7.12.4.2.1) in an
+ * X2 PDU (ETSI TS 103 221-2) to the Destinations (MDF2s) of a Task. Which
+ * messages, of which Tasks, to which Destinations is the config's to
+ * decide: the module only encodes and delivers.
+ *
+ * A request reported from a request route also has the replies this node
+ * generates for it reported, through tm: no route sees those.
+ */
+
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE /* F_SETPIPE_SZ */
+#endif
+#include <errno.h>
+#include <fcntl.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <netinet/in.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+
+#include "../../core/sr_module.h"
+#include "../../core/dprint.h"
+#include "../../core/mod_fix.h"
+#include "../../core/pt.h"
+#include "../../core/ut.h"
+#include "../../core/resolve.h"
+#include "../../core/route.h"
+#include "../../core/onsend.h"
+#include "../../core/rpc.h"
+#include "../../core/rpc_lookup.h"
+#include "../../core/kemi.h"
+#include "../../core/mem/shm_mem.h"
+#include "../../core/cfg/cfg_struct.h"
+#include "../../core/parser/msg_parser.h"
+#include "../../core/parser/parse_hname2.h"
+#include "../../modules/tm/tm_load.h"
+
+#include "x2_pdu.h"
+#include "x2_send.h"
+
+MODULE_VERSION
+
+static str x2_nfid = STR_NULL;
+static str x2_ipid = STR_NULL;
+int x2_keepalive_interval = 60;
+int x2_keepalive_timeout = 180;
+int x2_connect_timeout = 5;
+int x2_reconnect_interval = 5;
+int x2_idle_timeout = 600;
+int x2_dest_queue_size = 4 << 20;
+int x2_seq_lifetime = 3600;
+static int x2_queue_size = 16 << 20;
+static int x2_max_destinations = 32;
+
+x2_shared_t *x2_sh = NULL;
+int x2_pipe[2] = {-1, -1};
+
+static struct tm_binds x2_tmb;
+static int x2_have_tm = 0;
+
+/* What the local replies to a reported request are reported with */
+typedef struct x2_watch
+{
+	x2_iri_t iri;
+	int ndst;
+	x2_addr_t dst[X2_JOB_DST_MAX];
+	char matched[]; /* iri.matched points here */
+} x2_watch_t;
+
+static int mod_init(void);
+static int child_init(int rank);
+static void mod_destroy(void);
+static int w_x2_ims_message(sip_msg_t *msg, char *pdst, char *pxid, char *pcorr,
+		char *ppdir, char *psdir, char *pmatched);
+
+static rpc_export_t x2_rpc[];
+
+/* clang-format off */
+static cmd_export_t cmds[] = {
+	{"x2_ims_message", (cmd_function)w_x2_ims_message, 6, fixup_spve_all,
+		fixup_free_spve_all,
+		REQUEST_ROUTE | FAILURE_ROUTE | ONREPLY_ROUTE | BRANCH_ROUTE
+			| ONSEND_ROUTE},
+	{0, 0, 0, 0, 0, 0}
+};
+
+static param_export_t params[] = {
+	{"nfid", PARAM_STR, &x2_nfid},
+	{"ipid", PARAM_STR, &x2_ipid},
+	{"keepalive_interval", PARAM_INT, &x2_keepalive_interval},
+	{"keepalive_timeout", PARAM_INT, &x2_keepalive_timeout},
+	{"connect_timeout", PARAM_INT, &x2_connect_timeout},
+	{"reconnect_interval", PARAM_INT, &x2_reconnect_interval},
+	{"idle_timeout", PARAM_INT, &x2_idle_timeout},
+	{"queue_size", PARAM_INT, &x2_queue_size},
+	{"dest_queue_size", PARAM_INT, &x2_dest_queue_size},
+	{"max_destinations", PARAM_INT, &x2_max_destinations},
+	{"seq_lifetime", PARAM_INT, &x2_seq_lifetime},
+	{0, 0, 0}
+};
+
+struct module_exports exports = {
+	"x2",			 /* module name */
+	DEFAULT_DLFLAGS, /* dlopen flags */
+	cmds,			 /* exported functions */
+	params,			 /* exported parameters */
+	0,				 /* RPC method exports */
+	0,				 /* exported pseudo-variables */
+	0,				 /* response handling function */
+	mod_init,		 /* module initialization function */
+	child_init,		 /* per-child init function */
+	mod_destroy		 /* module destroy function */
+};
+/* clang-format on */
+
+static int mod_init(void)
+{
+	if(x2_max_destinations < 1 || x2_connect_timeout < 1
+			|| x2_reconnect_interval < 1 || x2_queue_size < 1
+			|| x2_dest_queue_size < 1 || x2_seq_lifetime < 1) {
+		LM_ERR("max_destinations, connect_timeout, reconnect_interval, "
+			   "queue_size, dest_queue_size and seq_lifetime are positive\n");
+		return -1;
+	}
+	if(x2_keepalive_interval > 0
+			&& x2_keepalive_timeout <= x2_keepalive_interval) {
+		LM_ERR("keepalive_timeout (%d) is to be longer than "
+			   "keepalive_interval (%d)\n",
+				x2_keepalive_timeout, x2_keepalive_interval);
+		return -1;
+	}
+
+	x2_sh = shm_mallocxz(
+			sizeof(x2_shared_t) + x2_max_destinations * sizeof(x2_dest_t));
+	if(x2_sh == NULL) {
+		SHM_MEM_ERROR;
+		return -1;
+	}
+	x2_sh->ndest = x2_max_destinations;
+
+	/* Each worker writes a job's address in one write(), atomic below
+	 * PIPE_BUF. Non-blocking: a worker drops an xIRI rather than wait */
+	if(pipe2(x2_pipe, O_NONBLOCK | O_CLOEXEC) < 0) {
+		LM_ERR("pipe: %s\n", strerror(errno));
+		return -1;
+	}
+	if(fcntl(x2_pipe[1], F_SETPIPE_SZ, 1 << 20) < 0)
+		LM_DBG("F_SETPIPE_SZ: %s\n", strerror(errno));
+
+	if(rpc_register_array(x2_rpc) != 0) {
+		LM_ERR("failed to register RPC commands\n");
+		return -1;
+	}
+
+	/* Without tm, only the messages the config sees are reported */
+	if(module_loaded("tm")) {
+		if(load_tm_api(&x2_tmb) < 0) {
+			LM_ERR("cannot load the tm API\n");
+			return -1;
+		}
+		x2_have_tm = 1;
+	}
+
+	register_procs(1);
+	cfg_register_child(1);
+	return 0;
+}
+
+static int child_init(int rank)
+{
+	int pid;
+
+	if(rank != PROC_MAIN)
+		return 0;
+
+	pid = fork_process(PROC_NOCHLDINIT, "X2 sender", 1);
+	if(pid < 0)
+		return -1;
+	if(pid == 0) {
+		if(cfg_child_init())
+			return -1;
+		x2_sender_loop();
+		exit(-1);
+	}
+	return 0;
+}
+
+static void mod_destroy(void)
+{
+	if(x2_sh) {
+		shm_free(x2_sh);
+		x2_sh = NULL;
+	}
+}
+
+/* [tcp:|udp:]host:port, the host an IPv4 address or a bracketed IPv6 one */
+static int x2_parse_addr(str *s, x2_addr_t *a)
+{
+	str host, port;
+	unsigned int p;
+	struct ip_addr *ip;
+	char *c;
+
+	host = *s;
+	a->proto = PROTO_TCP;
+	if(host.len > 4 && strncasecmp(host.s, "tcp:", 4) == 0) {
+		host.s += 4;
+		host.len -= 4;
+	} else if(host.len > 4 && strncasecmp(host.s, "udp:", 4) == 0) {
+		a->proto = PROTO_UDP;
+		host.s += 4;
+		host.len -= 4;
+	}
+	if(host.len > 0 && host.s[0] == '[') {
+		c = memchr(host.s, ']', host.len);
+		if(c == NULL || c + 1 >= host.s + host.len || c[1] != ':')
+			goto error;
+		port.s = c + 2;
+		host.s++;
+		host.len = c - host.s;
+	} else {
+		for(c = host.s + host.len - 1; c >= host.s && *c != ':'; c--)
+			;
+		if(c < host.s)
+			goto error;
+		port.s = c + 1;
+		host.len = c - host.s;
+	}
+	port.len = s->s + s->len - port.s;
+	if(port.len <= 0 || str2int(&port, &p) < 0 || p == 0 || p > 65535)
+		goto error;
+	ip = str2ip(&host);
+	if(ip == NULL)
+		ip = str2ip6(&host);
+	if(ip == NULL)
+		goto error;
+	if(init_su(&a->su, ip, (unsigned short)p) < 0)
+		goto error;
+	return 0;
+error:
+	LM_ERR("not a Destination: [%.*s]\n", s->len, s->s);
+	return -1;
+}
+
+/* The Destinations, separated by spaces or commas */
+static int x2_parse_dests(str *s, x2_addr_t *dst)
+{
+	str a;
+	char *p, *end;
+	int n = 0;
+
+	p = s->s;
+	end = s->s + s->len;
+	while(p < end) {
+		while(p < end && (*p == ' ' || *p == ',' || *p == '\t'))
+			p++;
+		if(p == end)
+			break;
+		a.s = p;
+		while(p < end && *p != ' ' && *p != ',' && *p != '\t')
+			p++;
+		a.len = p - a.s;
+		if(n == X2_JOB_DST_MAX) {
+			LM_ERR("more than %d Destinations, the rest left out\n",
+					X2_JOB_DST_MAX);
+			break;
+		}
+		if(x2_parse_addr(&a, &dst[n]) == 0)
+			n++;
+	}
+	return n;
+}
+
+/* A UUID (RFC 4122 text form), as the 128-bit XID (5.2.7) */
+static int x2_parse_uuid(str *s, unsigned char *out)
+{
+	int i, j = 0, h, l;
+
+	if(s->len != 36)
+		return -1;
+	for(i = 0; i < 36;) {
+		if(i == 8 || i == 13 || i == 18 || i == 23) {
+			if(s->s[i] != '-')
+				return -1;
+			i++;
+			continue;
+		}
+		h = hex2int(s->s[i]);
+		l = hex2int(s->s[i + 1]);
+		if(h < 0 || l < 0)
+			return -1;
+		out[j++] = (h << 4) | l;
+		i += 2;
+	}
+	return 0;
+}
+
+/* The Correlation ID: the decimal one given, or one from the Call-ID, the
+ * same for every message of the dialog at every IRI-POI it passes */
+static int x2_correlation(sip_msg_t *msg, str *s, uint64_t *corr)
+{
+	uint64_t h = 14695981039346656037ull;
+	char *end;
+	int i;
+
+	if(s->len > 0) {
+		for(i = 0; i < s->len; i++)
+			if(s->s[i] < '0' || s->s[i] > '9' || i == 20)
+				goto error;
+		errno = 0;
+		*corr = strtoull(s->s, &end, 10);
+		if(errno || end != s->s + s->len)
+			goto error;
+		return 0;
+	}
+	if(parse_headers(msg, HDR_CALLID_F, 0) < 0 || msg->callid == NULL) {
+		LM_ERR("no Call-ID to correlate by\n");
+		return -1;
+	}
+	for(i = 0; i < msg->callid->body.len; i++)
+		h = (h ^ (unsigned char)msg->callid->body.s[i]) * 1099511628211ull;
+	/* 0 is "not correlated" (5.2.8) */
+	*corr = h ? h : 1;
+	return 0;
+error:
+	LM_ERR("not a Correlation ID: [%.*s]\n", s->len, s->s);
+	return -1;
+}
+
+static int x2_ipproto(int proto)
+{
+	switch(proto) {
+		case PROTO_UDP:
+			return IPPROTO_UDP;
+		case PROTO_SCTP:
+			return IPPROTO_SCTP;
+		default:
+			return IPPROTO_TCP;
+	}
+}
+
+/* A socket bound to the wildcard address has no address of its own: the
+ * local end of a message it carried is the address the kernel takes towards
+ * the peer, which a connect() of a UDP socket finds without sending */
+static void x2_local_addr(struct ip_addr *local, struct ip_addr *peer)
+{
+	union sockaddr_union su, me;
+	socklen_t len = sizeof(me);
+	int fd;
+
+	if(!ip_addr_any(local) || peer->af == 0 || ip_addr_any(peer))
+		return;
+	if(init_su(&su, peer, 9) < 0)
+		return;
+	fd = socket(peer->af, SOCK_DGRAM | SOCK_CLOEXEC, 0);
+	if(fd < 0)
+		return;
+	if(connect(fd, &su.s, sockaddru_len(su)) == 0
+			&& getsockname(fd, &me.s, &len) == 0)
+		su2ip_addr(local, &me);
+	close(fd);
+}
+
+static int x2_queue(x2_job_t *job)
+{
+	ssize_t n;
+
+	if(atomic_add_int(&x2_sh->qbytes.val, job->len) > x2_queue_size) {
+		LM_ERR("X2 queue full, xIRI dropped\n");
+		goto drop;
+	}
+	n = write(x2_pipe[1], &job, sizeof(job));
+	if(n == sizeof(job))
+		return 1;
+	LM_ERR("X2 sender not keeping up (%s), xIRI dropped\n",
+			n < 0 ? strerror(errno) : "short write");
+drop:
+	atomic_add_int(&x2_sh->dropped.val, 1);
+	x2_job_free(job);
+	return -1;
+}
+
+/* A reply going out on a watched transaction: reported when this node made
+ * it, locally or as the 408 of a timeout. A relayed one was reported, as it
+ * came in, by the config */
+static void x2_reply_out(struct cell *t, int type, struct tmcb_params *ps)
+{
+	x2_watch_t *w;
+	x2_iri_t iri;
+	x2_job_t *job;
+
+	if(ps->param == NULL || *ps->param == NULL)
+		return;
+	if(!(ps->flags & TMCB_LOCAL_F) && ps->rpl != FAKED_REPLY)
+		return;
+	if(ps->dst == NULL || ps->dst->send_sock == NULL || ps->send_buf.s == NULL
+			|| ps->send_buf.len <= 0)
+		return;
+	w = (x2_watch_t *)*ps->param;
+	iri = w->iri;
+	iri.sip = ps->send_buf;
+	iri.src = ps->dst->send_sock->address;
+	iri.sport = ps->dst->send_sock->port_no;
+	su2ip_addr(&iri.dst, &ps->dst->to);
+	iri.dport = su_getport(&ps->dst->to);
+	iri.ipproto = x2_ipproto(ps->dst->proto);
+	x2_local_addr(&iri.src, &iri.dst);
+	gettimeofday(&iri.ts, NULL);
+	job = x2_ims_message_job(&iri, &x2_nfid, &x2_ipid, w->dst, w->ndst);
+	if(job)
+		x2_queue(job);
+}
+
+static void x2_watch_free(void *p)
+{
+	shm_free(p);
+}
+
+/* Has the replies this node generates for the request reported too, the
+ * other way: a reply to a request from the target goes to it */
+static void x2_watch(sip_msg_t *msg, x2_iri_t *iri, x2_addr_t *dst, int ndst)
+{
+	x2_watch_t *w;
+
+	if(msg->first_line.type != SIP_REQUEST
+			|| msg->first_line.u.request.method_value == METHOD_ACK)
+		return;
+	w = shm_malloc(sizeof(x2_watch_t) + iri->matched.len);
+	if(w == NULL) {
+		SHM_MEM_ERROR;
+		return;
+	}
+	memset(w, 0, sizeof(x2_watch_t));
+	w->iri = *iri;
+	w->iri.sip.s = NULL;
+	w->iri.sip.len = 0;
+	if(iri->pdir == X2_DIR_TO_TARGET)
+		w->iri.pdir = X2_DIR_FROM_TARGET;
+	else if(iri->pdir == X2_DIR_FROM_TARGET)
+		w->iri.pdir = X2_DIR_TO_TARGET;
+	memcpy(w->matched, iri->matched.s, iri->matched.len);
+	w->iri.matched.s = w->matched;
+	w->ndst = ndst;
+	memcpy(w->dst, dst, ndst * sizeof(x2_addr_t));
+	/* before the transaction exists, tm keeps it for when it does */
+	if(x2_tmb.register_tmcb(
+			   msg, 0, TMCB_RESPONSE_OUT, x2_reply_out, w, x2_watch_free)
+			< 0) {
+		LM_ERR("cannot watch the transaction for its replies\n");
+		shm_free(w);
+	}
+}
+
+static int ki_x2_ims_message(sip_msg_t *msg, str *dests, str *xid, str *corr,
+		str *pdir, str *sdir, str *matched)
+{
+	x2_addr_t dst[X2_JOB_DST_MAX];
+	x2_iri_t iri;
+	struct onsend_info *snd;
+	x2_job_t *job;
+	unsigned int v;
+	int ndst;
+
+	memset(&iri, 0, sizeof(iri));
+	ndst = x2_parse_dests(dests, dst);
+	if(ndst == 0) {
+		LM_ERR("no Destination\n");
+		return -1;
+	}
+	if(x2_parse_uuid(xid, iri.xid) < 0) {
+		LM_ERR("XID is not a UUID: [%.*s]\n", xid->len, xid->s);
+		return -1;
+	}
+	if(x2_correlation(msg, corr, &iri.corr) < 0)
+		return -1;
+	if(str2int(pdir, &v) < 0 || v < X2_DIR_UNKNOWN || v > X2_DIR_NA) {
+		LM_ERR("Payload Direction is 1 to 5: [%.*s]\n", pdir->len, pdir->s);
+		return -1;
+	}
+	iri.pdir = v;
+	if(str2int(sdir, &v) < 0 || v < X2_SESS_FROM_TARGET
+			|| v > X2_SESS_INDETERMINATE) {
+		LM_ERR("SessionDirection is 1 to 4: [%.*s]\n", sdir->len, sdir->s);
+		return -1;
+	}
+	iri.sdir = v;
+	if(matched)
+		iri.matched = *matched;
+
+	if(is_route_type(ONSEND_ROUTE)) {
+		/* the message as it goes out */
+		snd = get_onsend_info();
+		if(snd == NULL || snd->send_sock == NULL || snd->to == NULL) {
+			LM_ERR("no message being sent\n");
+			return -1;
+		}
+		iri.sip.s = snd->buf;
+		iri.sip.len = snd->len;
+		iri.src = snd->send_sock->address;
+		iri.sport = snd->send_sock->port_no;
+		su2ip_addr(&iri.dst, snd->to);
+		iri.dport = su_getport(snd->to);
+		iri.ipproto = x2_ipproto(snd->send_sock->proto);
+		x2_local_addr(&iri.src, &iri.dst);
+		gettimeofday(&iri.ts, NULL);
+	} else {
+		/* the message as it came in */
+		iri.sip.s = msg->buf;
+		iri.sip.len = msg->len;
+		iri.src = msg->rcv.src_ip;
+		iri.sport = msg->rcv.src_port;
+		iri.dst = msg->rcv.dst_ip;
+		iri.dport = msg->rcv.dst_port;
+		iri.ipproto = x2_ipproto(msg->rcv.proto);
+		x2_local_addr(&iri.dst, &iri.src);
+		iri.ts = msg->tval;
+		if(iri.ts.tv_sec == 0)
+			gettimeofday(&iri.ts, NULL);
+	}
+	if(iri.sip.s == NULL || iri.sip.len <= 0) {
+		LM_ERR("no SIP message\n");
+		return -1;
+	}
+
+	job = x2_ims_message_job(&iri, &x2_nfid, &x2_ipid, dst, ndst);
+	if(job == NULL)
+		return -1;
+	if(x2_have_tm && is_route_type(REQUEST_ROUTE))
+		x2_watch(msg, &iri, dst, ndst);
+	return x2_queue(job);
+}
+
+static int w_x2_ims_message(sip_msg_t *msg, char *pdst, char *pxid, char *pcorr,
+		char *ppdir, char *psdir, char *pmatched)
+{
+	str dests, xid, corr, pdir, sdir, matched;
+
+	if(fixup_get_svalue(msg, (gparam_t *)pdst, &dests) < 0
+			|| fixup_get_svalue(msg, (gparam_t *)pxid, &xid) < 0
+			|| fixup_get_svalue(msg, (gparam_t *)pcorr, &corr) < 0
+			|| fixup_get_svalue(msg, (gparam_t *)ppdir, &pdir) < 0
+			|| fixup_get_svalue(msg, (gparam_t *)psdir, &sdir) < 0
+			|| fixup_get_svalue(msg, (gparam_t *)pmatched, &matched) < 0) {
+		LM_ERR("cannot get the parameters\n");
+		return -1;
+	}
+	return ki_x2_ims_message(msg, &dests, &xid, &corr, &pdir, &sdir, &matched);
+}
+
+static const char *x2_state_name(int state)
+{
+	switch(state) {
+		case X2_UP:
+			return "up";
+		case X2_CONNECTING:
+			return "connecting";
+		default:
+			return "down";
+	}
+}
+
+static const char *x2_rpc_list_doc[2] = {
+		"List the X2 Destinations and their state", 0};
+
+static void x2_rpc_list(rpc_t *rpc, void *ctx)
+{
+	x2_dest_t *d;
+	void *th;
+	int i;
+
+	for(i = 0; i < x2_sh->ndest; i++) {
+		d = &x2_sh->dest[i];
+		if(!d->used)
+			continue;
+		if(rpc->add(ctx, "{", &th) < 0)
+			return;
+		rpc->struct_add(th, "ssjuujjj", "destination", x2_dest_name(d), "state",
+				x2_state_name(d->state), "since", (unsigned long)d->since,
+				"queued", d->qlen, "queued_bytes", d->qbytes, "sent", d->sent,
+				"dropped", d->dropped, "connects", d->connects);
+	}
+}
+
+static const char *x2_rpc_stats_doc[2] = {
+		"The PDUs in flight and those dropped before reaching a queue", 0};
+
+static void x2_rpc_stats(rpc_t *rpc, void *ctx)
+{
+	void *th;
+
+	if(rpc->add(ctx, "{", &th) < 0)
+		return;
+	rpc->struct_add(th, "dd", "queued_bytes", atomic_get(&x2_sh->qbytes),
+			"dropped", atomic_get(&x2_sh->dropped));
+}
+
+static rpc_export_t x2_rpc[] = {
+		{"x2.list", x2_rpc_list, x2_rpc_list_doc, RET_ARRAY},
+		{"x2.stats", x2_rpc_stats, x2_rpc_stats_doc, 0}, {0, 0, 0, 0}};
+
+/* clang-format off */
+static sr_kemi_t sr_kemi_x2_exports[] = {
+	{ str_init("x2"), str_init("ims_message"),
+		SR_KEMIP_INT, ki_x2_ims_message,
+		{ SR_KEMIP_STR, SR_KEMIP_STR, SR_KEMIP_STR,
+			SR_KEMIP_STR, SR_KEMIP_STR, SR_KEMIP_STR }
+	},
+
+	{ {0, 0}, {0, 0}, 0, NULL, { 0, 0, 0, 0, 0, 0 } }
+};
+/* clang-format on */
+
+int mod_register(char *path, int *dlflags, void *p1, void *p2)
+{
+	sr_kemi_modules_add(sr_kemi_x2_exports);
+	return 0;
+}
