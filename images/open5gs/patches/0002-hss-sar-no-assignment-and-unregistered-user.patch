+void hss_cx_get_restoration_info(char *public_identity,
+        char **user_name, char **contact, char **path)
+{
+    hss_impu_t *impu = NULL;
+
+    *user_name = NULL;
+    *contact = NULL;
+    *path = NULL;
+
+    ogs_thread_mutex_lock(&self.cx_lock);
+
+    impu = impu_find_by_id(public_identity);
+    if (impu && impu->impi) {
+        *user_name = impu->impi->id;
+        *contact = impu->restoration_contact;
+        *path = impu->restoration_path;
+    }
+
+    ogs_thread_mutex_unlock(&self.cx_lock);
+}
+
+void hss_cx_set_restoration_info(
+        char *public_identity, char *contact, char *path)
+{
+    hss_impu_t *impu = NULL;
+    hss_impu_t *sibling = NULL;
+
+    ogs_thread_mutex_lock(&self.cx_lock);
+
+    impu = impu_find_by_id(public_identity);
+    ogs_assert(impu);
+    ogs_assert(impu->impi);
+
+    /*
+     * Every public identity in the implicit set, not only the one this SAR
+     * named: the S-CSCF backs up restoration information once per REGISTER,
+     * against whichever form of the identity it sent (kamailio sends the
+     * IMSI-form one) -- but a terminating request restores by whatever form
+     * the caller dialled, MSISDN-form after ENUM. Storing under one form
+     * only would leave it invisible from every other.
+     */
+    ogs_list_for_each(&impu->impi->impu_list, sibling) {
+        if (sibling->restoration_contact)
+            ogs_free(sibling->restoration_contact);
+        sibling->restoration_contact = contact ? ogs_strdup(contact) : NULL;
+
+        if (sibling->restoration_path)
+            ogs_free(sibling->restoration_path);
+        sibling->restoration_path = path ? ogs_strdup(path) : NULL;
+    }
+
+    ogs_thread_mutex_unlock(&self.cx_lock);
+}
+
 char *hss_cx_download_user_data(
         char *user_name, char *visited_network_identifier,
         ogs_ims_data_t *ims_data)
