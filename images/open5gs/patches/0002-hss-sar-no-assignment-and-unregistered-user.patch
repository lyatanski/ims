+/* Adds an OctetString AVP holding the C string value to parent */
+static int add_os_avp(struct avp *parent, struct dict_object *model,
+        char *value)
+{
+    struct avp *child = NULL;
+    union avp_value val;
+    int ret;
+
+    ret = fd_msg_avp_new(model, 0, &child);
+    if (ret != 0)
+        return ret;
+    val.os.data = (uint8_t *)value;
+    val.os.len = strlen(value);
+    ret = fd_msg_avp_setvalue(child, &val);
+    if (ret == 0)
+        ret = fd_msg_avp_add(parent, MSG_BRW_LAST_CHILD, child);
+    if (ret != 0)
+        fd_msg_free((msg_or_avp *)child);
+    return ret;
+}
+
+/*
+ * TS 29.229 6.3.46/6.3.52, all three values mandatory:
+ *   SCSCF-Restoration-Info ::= { User-Name } 1*{ Restoration-Info } ...
+ *   Restoration-Info ::= { Path } { Contact } ...
+ */
+static int add_scscf_restoration_info(struct msg *ans, char *user_name,
+        char *path, char *contact)
+{
+    struct avp *sri_avp = NULL, *ri_avp = NULL;
+    int ret;
+
+    ret = fd_msg_avp_new(ogs_diam_cx_restoration_info, 0, &ri_avp);
+    if (ret != 0)
+        return ret;
+    if ((ret = add_os_avp(ri_avp, ogs_diam_cx_path, path)) != 0 ||
+        (ret = add_os_avp(ri_avp, ogs_diam_cx_contact, contact)) != 0) {
+        fd_msg_free((msg_or_avp *)ri_avp);
+        return ret;
+    }
+
+    ret = fd_msg_avp_new(ogs_diam_cx_scscf_restoration_info, 0, &sri_avp);
+    if (ret != 0) {
+        fd_msg_free((msg_or_avp *)ri_avp);
+        return ret;
+    }
+    if ((ret = add_os_avp(sri_avp, ogs_diam_user_name, user_name)) != 0) {
+        fd_msg_free((msg_or_avp *)ri_avp);
+        fd_msg_free((msg_or_avp *)sri_avp);
+        return ret;
+    }
+    ret = fd_msg_avp_add(sri_avp, MSG_BRW_LAST_CHILD, ri_avp);
+    if (ret != 0) {
+        fd_msg_free((msg_or_avp *)ri_avp);
+        fd_msg_free((msg_or_avp *)sri_avp);
+        return ret;
+    }
+
+    ret = fd_msg_avp_add(ans, MSG_BRW_LAST_CHILD, sri_avp);
+    if (ret != 0)
+        fd_msg_free((msg_or_avp *)sri_avp);
+    return ret;
+}
+
+/*
+ * The Feature-List of the Cx feature list (Vendor-Id 3GPP, Feature-List-ID 1)
+ * among the request's Supported-Features AVPs, or 0 when it has none -- an
+ * S-CSCF that advertises nothing supports nothing beyond Rel-5 (TS 29.229 7.2).
+ */
+static uint32_t cx_feature_list(struct msg *qry)
+{
+    struct avp *avp = NULL, *child = NULL;
+    struct avp_hdr *hdr = NULL, *child_hdr = NULL;
+
+    if (fd_msg_browse(qry, MSG_BRW_FIRST_CHILD, (void *)&avp, NULL) != 0)
+        return 0;
+    for (; avp; fd_msg_browse(avp, MSG_BRW_NEXT, (void *)&avp, NULL)) {
+        if (fd_msg_avp_hdr(avp, &hdr) != 0 || !hdr ||
+                hdr->avp_code != 628 || hdr->avp_vendor != OGS_3GPP_VENDOR_ID)
+            continue;
+
+        if (fd_msg_search_avp(avp, ogs_diam_vendor_id, &child) != 0 ||
+                !child || fd_msg_avp_hdr(child, &child_hdr) != 0 ||
+                !child_hdr || child_hdr->avp_value->u32 != OGS_3GPP_VENDOR_ID)
+            continue;
+        if (fd_msg_search_avp(avp, ogs_diam_cx_feature_list_id, &child) != 0 ||
+                !child || fd_msg_avp_hdr(child, &child_hdr) != 0 ||
+                !child_hdr ||
+                child_hdr->avp_value->u32 != OGS_DIAM_CX_FEATURE_LIST_ID)
+            continue;
+        if (fd_msg_search_avp(avp, ogs_diam_cx_feature_list, &child) != 0 ||
+                !child || fd_msg_avp_hdr(child, &child_hdr) != 0 ||
+                !child_hdr)
+            continue;
+
+        return child_hdr->avp_value->u32;
+    }
+
+    return 0;
+}
+
+/*
+ * An answer lists the complete set of features its sender supports (TS 29.229
+ * 7.2), with the M bit never set (7.2.1) -- which fd_msg_avp_new() already
+ * leaves clear, the dictionary having M as "may" for Supported-Features and
+ * "must not" for its members. The only Cx feature this HSS implements is
+ * IMSRestorationInd.
+ */
+static int add_supported_features(struct msg *ans)
+{
+    struct avp *avp = NULL, *child = NULL;
+    union avp_value val;
+    int ret;
+
+    ret = fd_msg_avp_new(ogs_diam_cx_supported_features, 0, &avp);
+    if (ret != 0)
+        return ret;
+
+    ret = fd_msg_avp_new(ogs_diam_vendor_id, 0, &child);
+    if (ret == 0) {
+        val.u32 = OGS_3GPP_VENDOR_ID;
+        ret = fd_msg_avp_setvalue(child, &val);
+        if (ret == 0)
+            ret = fd_msg_avp_add(avp, MSG_BRW_LAST_CHILD, child);
+        else
+            fd_msg_free((msg_or_avp *)child);
+    }
+    if (ret == 0)
+        ret = fd_msg_avp_new(ogs_diam_cx_feature_list_id, 0, &child);
+    if (ret == 0) {
+        val.u32 = OGS_DIAM_CX_FEATURE_LIST_ID;
+        ret = fd_msg_avp_setvalue(child, &val);
+        if (ret == 0)
+            ret = fd_msg_avp_add(avp, MSG_BRW_LAST_CHILD, child);
+        else
+            fd_msg_free((msg_or_avp *)child);
+    }
+    if (ret == 0)
+        ret = fd_msg_avp_new(ogs_diam_cx_feature_list, 0, &child);
+    if (ret == 0) {
+        val.u32 = OGS_DIAM_CX_FEATURE_IMS_RESTORATION_IND;
+        ret = fd_msg_avp_setvalue(child, &val);
+        if (ret == 0)
+            ret = fd_msg_avp_add(avp, MSG_BRW_LAST_CHILD, child);
+        else
+            fd_msg_free((msg_or_avp *)child);
+    }
+    if (ret == 0)
+        ret = fd_msg_avp_add(ans, MSG_BRW_LAST_CHILD, avp);
+    if (ret != 0)
+        fd_msg_free((msg_or_avp *)avp);
+    return ret;
+}
+
