MCC=001
MNC=01
SCALE=10
REALM=mnc${MNC}.mcc${MCC}.3gppnetwork.org
NETv4=192.168.69.0/24
NETv6=fdc0:a845::/64
DNSv4=192.168.69.69
DNSv6=fdc0:a845::69
IPSEC=192.168.69.70
IPSECv6=fdc0:a845::70
DIAL=359
# DIAL with its digits reversed, which is the order they appear in an ENUM name
# (RFC 6116), and dot-escaped because it lands in the zone's match regex. The
# CoreDNS zone answers only for numbers starting with DIAL, so the two are
# changed together; compose has no way to derive one from the other, while the
# helm chart derives it from global.e164.home.
DIALR=9\.5\.3
K=3919F39741B626604B4BACE23ACFB094
OPC=177FAD988A964A3AD0421B4693257056
UENET=10.10.0.0/16
UEGW=10.10.0.1
# open5gs hands every UE a /64 of this (and the full address prefix::n in
# the PAA); the UPF routes downlink by that /64
UENETv6=fd10:10::/48
UEGWv6=fd10:10::1
# rtpengine's Mx address, which its ng control socket binds
RTPv4=192.168.69.72
# Ici, the interconnect (TS 23.228 Annex K): this network's IBCF and TrGW
# addresses on it, and the peer network's entry point
NETICI=192.168.71.0/24
ICI=192.168.71.10
ICIRTP=192.168.71.20
ICIPEER=192.168.71.30
# The peer network: its domain and the E.164 range behind it. 999 is a code
# ITU-T keeps unassigned, so it cannot clash with a real country
PEERDOMAIN=ims.mnc099.mcc001.3gppnetwork.org
PEERDIAL=999
